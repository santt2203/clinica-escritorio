<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Clínica PAP</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/clinica.css">
    <script defer src="${pageContext.request.contextPath}/assets/clinica.js"></script>
</head>
<body>
<header class="site-header">
    <a class="brand" href="${pageContext.request.contextPath}/catalogo">Clínica PAP</a>
    <nav aria-label="Navegación principal">
        <a href="${pageContext.request.contextPath}/catalogo">Catálogo</a>
        <c:choose>
            <c:when test="${sessionScope.rol == 'MEDICO'}">
                <a href="${pageContext.request.contextPath}/medico/prestaciones/nueva">Nueva prestación</a>
            </c:when>
            <c:when test="${sessionScope.rol == 'PACIENTE'}">
                <a href="${pageContext.request.contextPath}/paciente/seguidas">Seguidas</a>
                <a href="${pageContext.request.contextPath}/paciente/solicitud">Mi solicitud</a>
                <a href="${pageContext.request.contextPath}/paciente/ordenes">Mis órdenes</a>
            </c:when>
        </c:choose>
        <c:choose>
            <c:when test="${empty sessionScope.token}">
                <a href="${pageContext.request.contextPath}/login">Ingresar</a>
                <a href="${pageContext.request.contextPath}/registro">Registrarse</a>
            </c:when>
            <c:otherwise>
                <span class="user"><c:out value="${sessionScope.usuario.nombre}"/></span>
                <form action="${pageContext.request.contextPath}/logout" method="post" class="inline">
                    <button class="link-button" type="submit">Salir</button>
                </form>
            </c:otherwise>
        </c:choose>
    </nav>
</header>
<main class="container">
<c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty mensaje}"><div class="alert success" role="status"><c:out value="${mensaje}"/></div></c:if>
